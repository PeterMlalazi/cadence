# Copy to .env for local testing with `vercel dev`. On Vercel, add these in Project Settings > Environment Variables.

# Any passcode you like. The app asks for it once on your phone.
APP_PASSCODE=

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Created once with scripts/strava-token.mjs
STRAVA_REFRESH_TOKEN=

# From https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5
COACH_MODEL=
